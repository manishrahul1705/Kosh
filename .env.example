APP_ENV=development

# SQLite for Stage 1. PostgreSQL later, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/gem
DATABASE_URL=sqlite:///./data/gem.db
AUTO_MIGRATE=true

# Official public GeM bid listing
GEM_BID_LIST_URL=https://bidplus.gem.gov.in/all-bids
# Optional: JSON endpoint the listing page posts to (default: <origin>/all-bids-data)
GEM_BID_DATA_URL=
GEM_SORT=Bid-Start-Date-Latest
# What the trailing "Z" on listing timestamps means. Keep UTC unless verified otherwise (README).
GEM_API_TIMESTAMP_ZONE=UTC
USER_AGENT=GeMTenderIntelligence/1.0 (Stage-1 public bid discovery)

COLLECTION_INTERVAL_MINUTES=30
COLLECT_ON_STARTUP=true
SCHEDULER_ENABLED=true

REQUEST_TIMEOUT_SECONDS=30
REQUEST_DELAY_SECONDS=2
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=2
MAX_RETRY_AFTER_SECONDS=300
MAX_PAGES_PER_RUN=100

# auto | http | browser | fixture
COLLECTOR_MODE=auto
FIXTURE_DIR=tests/fixtures/gem/default

MARK_EXPIRED_AS_CLOSED=true

# ============================================================================
# STAGE 2: DOCUMENT DISCOVERY & DOWNLOAD
# ============================================================================

# Where to store downloaded documents
DOCUMENT_STORAGE_PATH=./data/tenders

# Maximum file size to download (in MB)
MAX_DOCUMENT_SIZE_MB=100

# HTTP request timeout for document downloads (seconds)
DOCUMENT_REQUEST_TIMEOUT_SECONDS=60

# Retry policy for failed document downloads
DOCUMENT_MAX_RETRIES=3
DOCUMENT_REQUEST_DELAY_SECONDS=2

# How often to check for new documents on existing tenders (minutes)
DOCUMENT_REFRESH_INTERVAL_MINUTES=60

# Stage 2B processes ONE job at a time (SQLite MVP); values > 1 are clamped to 1
DOCUMENT_WORKER_CONCURRENCY=1

# Queue a NEW_TENDER document job when Stage 1 discovers a new tender
AUTO_DOWNLOAD_NEW_TENDERS=true

# Save debug snapshots of tender pages (for troubleshooting)
SAVE_DOCUMENT_DEBUG_SNAPSHOTS=false

# ============================================================================
# STAGE 2B: AUTOMATED DOCUMENT JOB PROCESSING
# ============================================================================

# Run the document worker inside the API scheduler (uvicorn app.main:app).
# Keep false until the controlled live test passed:
#   python scripts/run_document_worker.py --bid GEM/2026/B/8122868
DOCUMENT_WORKER_ENABLED=false

# Worker poll frequency (seconds) and jobs processed per poll
DOCUMENT_JOB_POLL_SECONDS=30
DOCUMENT_WORKER_MAX_JOBS_PER_RUN=1
# Pause between consecutive jobs within one run (outbound GeM pacing)
DOCUMENT_INTER_JOB_DELAY_SECONDS=10

# Job-level retries (separate from the per-request DOCUMENT_MAX_RETRIES above)
DOCUMENT_MAX_ATTEMPTS=3
DOCUMENT_RETRY_BACKOFF_MINUTES=15
DOCUMENT_RETRY_MAX_BACKOFF_MINUTES=360

# A RUNNING job older than this is treated as orphaned (crash recovery)
DOCUMENT_STALE_RUNNING_MINUTES=30

# After a BLOCKED job (CAPTCHA / 401 / 403) pause ALL document processing
DOCUMENT_BLOCK_COOLDOWN_MINUTES=60

# Periodic refresh of ONGOING tenders (due-time based; DOCUMENT_REFRESH_INTERVAL_MINUTES above)
PERIODIC_DOCUMENT_REFRESH_ENABLED=true
DOCUMENT_REFRESH_CHECK_MINUTES=10
DOCUMENT_REFRESH_BATCH_SIZE=10

# Queue exactly one final refresh when a tender goes ONGOING -> CLOSED
FINAL_REFRESH_ON_CLOSE=true

# Default --limit for scripts/backfill_document_jobs.py
DOCUMENT_BACKFILL_BATCH_SIZE=10

# Lock files (empty = next to LOCK_FILE: data/document_worker.lock, data/scheduler.lock)
DOCUMENT_WORKER_LOCK_FILE=
SCHEDULER_LOCK_FILE=

# ============================================================================
# STAGE 3A: DOCUMENT TEXT / TABLE / STRUCTURE EXTRACTION (local, never contacts GeM)
# ============================================================================

# Run the extraction worker inside the API scheduler. Keep false until the
# controlled one-document check passed (LOCAL_VERIFICATION_STAGE3A.md).
EXTRACTION_WORKER_ENABLED=false
# Queue an extraction job automatically when Stage 2 stores a new VALID version
EXTRACTION_AUTO_QUEUE=true
EXTRACTION_JOB_POLL_SECONDS=30
EXTRACTION_WORKER_MAX_JOBS_PER_RUN=1
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_RETRY_BACKOFF_MINUTES=5
EXTRACTION_RETRY_MAX_BACKOFF_MINUTES=120
EXTRACTION_STALE_RUNNING_MINUTES=30
# Default --limit for scripts/backfill_extraction_jobs.py
EXTRACTION_BACKFILL_BATCH_SIZE=20
# A page "has text" with at least this many letters/digits
EXTRACTION_MIN_PAGE_CHARS=20
# Pages beyond this are not parsed (extraction becomes PARTIAL / PAGE_LIMIT)
EXTRACTION_MAX_PAGES=500
EXTRACTION_TABLES_ENABLED=true
# Optional local OCR for image-only pages (needs: pip install pytesseract + Tesseract binary)
OCR_ENABLED=false
OCR_LANGUAGES=eng
OCR_DPI=200
# Empty = data/extraction_worker.lock (next to LOCK_FILE)
EXTRACTION_WORKER_LOCK_FILE=

# ============================================================================
# STAGE 3B: DETERMINISTIC TENDER FIELD EXTRACTION (reads Stage 3A rows only;
# no GeM access, no PDF parsing, no AI / LLM)
# ============================================================================

# Run the field-extraction worker inside the API scheduler. Keep false until the
# controlled one-extraction check passed (LOCAL_VERIFICATION_STAGE3B.md).
FIELD_EXTRACTION_WORKER_ENABLED=false
# Queue a field-extraction job automatically after a Stage 3A extraction commits
# (SUCCESS / PARTIAL_SUCCESS only). Queueing never processes anything by itself.
FIELD_EXTRACTION_AUTO_QUEUE=true
FIELD_EXTRACTION_JOB_POLL_SECONDS=30
FIELD_EXTRACTION_WORKER_MAX_JOBS_PER_RUN=1
FIELD_EXTRACTION_MAX_ATTEMPTS=3
FIELD_EXTRACTION_RETRY_BACKOFF_MINUTES=5
FIELD_EXTRACTION_STALE_RUNNING_MINUTES=30
# Default --limit for scripts/backfill_field_extraction_jobs.py
FIELD_EXTRACTION_BACKFILL_BATCH_SIZE=20
# Zone of the wall-clock dates printed in GeM bid PDFs (stored as UTC + local)
FIELD_EXTRACTION_DOCUMENT_TIMEZONE=Asia/Kolkata
# Empty = data/field_extraction_worker.lock (next to LOCK_FILE)
FIELD_EXTRACTION_WORKER_LOCK_FILE=

# ============================================================================
# STAGE 3C: AI-ASSISTED REQUIREMENT INTERPRETATION (reads Stage 3A/3B rows only;
# never contacts GeM; sends bounded tender evidence to the configured AI provider)
# ============================================================================

# Provider: gemini | openai_compatible | mock (offline, no cost) | empty = not configured
AI_PROVIDER=
# Model name as the provider expects it (e.g. a current Gemini or OpenAI-compatible model id)
AI_MODEL=
# SECRET - put the real key only in your local .env (never commit it). Never logged or stored.
AI_API_KEY=
# Empty = provider default (gemini: Google endpoint). Required for non-OpenAI compatible servers.
AI_BASE_URL=
AI_REQUEST_TIMEOUT_SECONDS=60
# Immediate retries for transient errors only (timeout / 429 / 5xx). Auth/config errors never retry.
AI_MAX_RETRIES=1
AI_RETRY_BASE_DELAY_SECONDS=2
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0
AI_OPENAI_JSON_MODE=true
# Cost / size controls for what is sent per analysis (input characters = the WHOLE prompt, min 6000)
AI_MAX_CHUNKS_PER_ANALYSIS=40
AI_MAX_INPUT_CHARACTERS=30000
AI_MAX_CHUNK_CHARACTERS=3000
# GeM standard disclaimer / GTC text is not sent unless true
AI_INCLUDE_BOILERPLATE=false
# Run the AI worker inside the API scheduler. KEEP false unless you accept provider cost.
AI_ANALYSIS_WORKER_ENABLED=false
# Queue (not run) an analysis job after each new Stage 3B run
AI_ANALYSIS_AUTO_QUEUE=true
AI_ANALYSIS_JOB_POLL_SECONDS=60
AI_MAX_JOBS_PER_RUN=1
AI_ANALYSIS_MAX_ATTEMPTS=3
AI_ANALYSIS_RETRY_BACKOFF_MINUTES=10
AI_ANALYSIS_STALE_RUNNING_MINUTES=30
# Hard cap on provider calls (every attempt) per rolling 24 h (0 = never call the provider)
AI_MAX_ANALYSES_PER_DAY=20
# Pause after an auth / configuration failure (minutes)
AI_BLOCKED_COOLDOWN_MINUTES=60
# Empty = data/ai_analysis_worker.lock (next to LOCK_FILE)
AI_ANALYSIS_WORKER_LOCK_FILE=

# ============================================================================
# GENERAL
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=text

SAVE_DEBUG_SNAPSHOTS=false
DEBUG_DIR=data/debug
LOCK_FILE=data/collection.lock

# Stage 0007: conservative annotation discovery and tender corpus analysis.
# Exact hosts only (no wildcard/suffix matching). HTTPS and public DNS required.
DOCUMENT_REFERENCE_DISCOVERY_ENABLED=true
DOCUMENT_REFERENCE_MAX_DEPTH=3
DOCUMENT_REFERENCE_MAX_PER_DOCUMENT=50
DOCUMENT_REFERENCE_MAX_PER_TENDER=200
DOCUMENT_REFERENCE_MAX_ACQUISITIONS=30
DOCUMENT_REFERENCE_ALLOWED_HOSTS=bidplus.gem.gov.in,mkp.gem.gov.in,admin.gem.gov.in
DOCUMENT_REFERENCE_REQUIRE_HTTPS=true
# DOCUMENT is an explicit legacy maintenance mode only.
AI_ANALYSIS_SCOPE=TENDER_CORPUS

# ============================================================================
# AUTHENTICATION (Supabase)
# ============================================================================
# Project URL only. Tokens are verified with the project's public JWKS; no service key is needed
# or used by the backend. Never put a service-role key in this file or in the frontend.
SUPABASE_URL=https://your-project.supabase.co

# Local test sign-in without Supabase (email only, no password). DEVELOPMENT ONLY:
# refused when APP_ENV=production and only answers requests from this computer.
# The frontend also needs VITE_DEV_LOGIN=true in frontend/.env.local.
DEV_LOGIN_ENABLED=false

# ============================================================================
# STATUS VERIFICATION + SELLER MATCHING (deterministic, no AI calls)
# ============================================================================
STATUS_CHECK_INTERVAL_MINUTES=15
MATCHING_ENABLED=true
MATCHING_INTERVAL_MINUTES=15
MATCHING_MAX_EVALUATIONS_PER_RUN=500

# Safe local Stage 0 process overrides; use a new disposable database.
# DATABASE_URL=sqlite:///./kosh_dev.db
# SCHEDULER_ENABLED=false
# AUTO_MIGRATE=false
# COLLECT_ON_STARTUP=false
# STARTUP_RECOVERY_ENABLED=false
# APP_ENV=development
# No new Kosh configuration variables are required in Stage 0.

# Kosh local databases: kosh_dev.db is an empty disposable test database.
# kosh_work.db is a local working copy of public tender data plus Kosh tables.
# Never point development commands at the original database.
KOSH_PRIVATE_STORAGE_PATH=./private_storage
KOSH_MAX_UPLOAD_MB=10
